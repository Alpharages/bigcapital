{
  "version": 2,
  "installCommand": "pnpm install",
  "buildCommand": "pnpm run build",
  "outputDirectory": "packages/webapp/build",
  "builds": [
    {
      "src": "packages/server/build/server.js",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [{
    "source": "/api/(.*)",
    "destination": "packages/server/build/server.js"
  },
    {
      "source": "/(.*)",
      "destination": "packages/webapp/build"
    }
  ],
  "build": {
    "env": {
      "NODE_VERSION": "18.x"
    }
  }
}