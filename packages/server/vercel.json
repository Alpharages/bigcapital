{
  "version": 2,
  "installCommand": "pnpm install",
  "buildCommand": "pnpm run build",
  "outputDirectory": "packages/server/build",
  "builds": [
    {
      "src": "./index.js",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [{
    "source": "/(.*)",
    "dest": "/"
  }
  ],
  "build": {
    "env": {
      "NODE_VERSION": "18.x"
    }
  }
}